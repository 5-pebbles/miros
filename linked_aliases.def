# Symbol aliases miros exports, one per line:
#   target: alias, alias(weak), ...
# The target must be an existing exported miros symbol; aliases are emitted as assembler .set directives.

__environ: environ(weak), _environ(weak)

__signgam: signgam(weak)

__progname: program_invocation_short_name(weak)

__progname_full: program_invocation_name(weak)
